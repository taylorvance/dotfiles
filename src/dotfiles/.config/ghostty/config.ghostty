# Ghostty configuration
# See: ghostty +show-config --default --docs

# Nerd Font for terminal icons: brew install --cask font-hack-nerd-font
font-family = "Hack Nerd Font Mono"
font-size = 12

# Matches nvim (tokyonight) and bat (tokyonight_moon)
theme = TokyoNight Moon

cursor-style-blink = false

# Close tabs and windows without a prompt
confirm-close-surface = false

maximize = true

# Copy selected text to the system clipboard
copy-on-select = clipboard

# Shift+Enter inserts a newline in Claude Code. Inside tmux it otherwise
# arrives as plain Enter and submits the prompt.
keybind = shift+enter=text:\n

# Ctrl+` drops down a terminal from any app (global: needs Accessibility
# permission, and takes the key from every app). It runs plain zsh outside
# tmux, so Ghostty's search and prompt jumps work there.
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# Install Ghostty's terminfo on SSH hosts so TERM=xterm-ghostty works there,
# falling back to xterm-256color if that fails. Unlisted features keep defaults.
shell-integration-features = ssh-env,ssh-terminfo
