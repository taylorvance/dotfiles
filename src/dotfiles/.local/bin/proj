#!/bin/bash
# proj - tmux session manager
#
# Manage tmux sessions with intuitive create/attach/kill operations.

set -e

show_help() {
	cat <<EOF
Usage: proj [OPTIONS] [NAME]

Tmux session manager.

USAGE:
    proj                 fzf picker of existing sessions, most recent first → attach
    proj NAME            attach to session by name (fzf on multiple matches,
                         error if none match)
    proj -c [NAME]       create session from cwd (name defaults to basename \$PWD)
    proj -k [NAME]       kill session (current session if in tmux, else fzf picker)

OPTIONS:
    -c, --create [NAME]  Create session from cwd
    -k, --kill [NAME]    Kill a session
    -h, --help           Show this help message

EXAMPLES:
    proj                 Pick from existing sessions (Enter = most recent)
    proj dotfiles        Attach to "dotfiles" session
    proj dot             Attach if unambiguous, fzf if multiple matches,
                         error if none match
    proj -c              Create session named after current directory
    proj -c myapp        Create session named "myapp" from current directory
    proj -k              Kill current session (or fzf pick if not in tmux)
    proj -k dotfiles     Kill "dotfiles" session

NOTES:
    If the tmux server is down or empty (e.g. after a reboot), proj first
    restores saved sessions via tmux-resurrect, then proceeds as usual.

    "Most recent" means you last typed in or switched to the session. tmux
    forgets that on reboot, so sessions not visited since the restore rank
    by tmux-resurrect's save history instead, then by name.

EOF
}

die() {
	echo "Error: $1" >&2
	exit 1
}

in_tmux() {
	[ -n "$TMUX" ]
}

session_exists() {
	tmux has-session -t="$1" 2>/dev/null
}

list_sessions() {
	tmux list-sessions -F '#{session_name}' 2>/dev/null
}

# resurrect registers its save dir as a server option; unset, it uses the XDG
# location, or the legacy one when only that holds saves
resurrect_dir() {
	local save_dir
	save_dir=$(tmux show-option -gqv '@resurrect-dir' 2>/dev/null) || true
	[ -n "$save_dir" ] || save_dir="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"
	save_dir="${save_dir/#\~/$HOME}"
	[ -e "$save_dir/last" ] || save_dir="$HOME/.tmux/resurrect"
	printf '%s\n' "$save_dir"
}

# Session names from tmux-resurrect's saves, newest save first, repeats kept.
# Each save records the session the active client was on, then the one it
# came from, so the sequence traces where you were before the last reboot.
resurrect_history() {
	set -- "$(resurrect_dir)"/tmux_resurrect_*.txt
	[ -e "$1" ] || return 0
	# Save names embed a sortable timestamp, so reversing them is newest first
	awk -F '\t' '$1 == "state" { print FILENAME "\t" $2 "\t" $3 }' "$@" |
		sort -r |
		awk -F '\t' '{ print $2; if ($3 != "") print $3 }'
}

# Session names, most recently used first. tmux stamps a session's activity
# on each keypress or switch, but only in memory: a restore leaves every
# session with the same activity and no attach time. So sessions attached
# since the server started rank by activity, the rest by resurrect's save
# history (no proj-owned state file to keep in sync), and any left by name.
# Inside tmux the current session stays in its recency slot, usually first.
sessions_by_recency() {
	local tab
	tab=$(printf '\t')
	{
		resurrect_history | sed "s/^/h$tab/"
		tmux list-sessions -F "#{session_last_attached}$tab#{session_activity}$tab#{session_name}" 2>/dev/null |
			sed "s/^/s$tab/"
	} | awk -F '\t' '
		$1 == "h" { if (!($2 in rank)) rank[$2] = ++n; next }
		$2 + 0 > 0 { print 1 "\t" $3 "\t" $4; next }
		$4 in rank { print 2 "\t-" rank[$4] "\t" $4; next }
		{ print 3 "\t0\t" $4 }
	' | sort -t "$tab" -k1,1n -k2,2nr -k3 | cut -f3-
}

attach_session() {
	local name="$1"
	if in_tmux; then
		tmux switch-client -t "$name"
	else
		tmux attach-session -t "$name"
	fi
}

# After a reboot there is no tmux server, so saved sessions "don't exist"
# until something restores them. tmux-continuum's auto-restore can't be
# trusted with that: it fires in the background ~1s after the server starts
# (merging saved windows into whatever was just created, killing/replacing
# fresh panes on name collisions) and silently skips entirely if it sees any
# other tmux process. So auto-restore is off (see .tmux.conf) and proj owns
# restore: when the server is down or empty, run tmux-resurrect's restore
# synchronously before any session lookup, create, or kill.
maybe_restore() {
	if list_sessions | grep -q .; then
		return 0 # live sessions exist; never restore over them
	fi

	# restore.sh needs a running server; a throwaway session provides one
	tmux new-session -d -s "__proj_restore__" 2>/dev/null || true

	# resurrect registers its script path as a server option
	local script save_dir
	script=$(tmux show-option -gqv '@resurrect-restore-script-path' 2>/dev/null) || true
	[ -n "$script" ] || script="$HOME/.tmux/plugins/tmux-resurrect/scripts/restore.sh"
	save_dir=$(resurrect_dir)

	if [ -e "$save_dir/last" ]; then
		if [ -x "$script" ]; then
			echo "Restoring saved tmux sessions..." >&2
			# restore.sh derives the server socket from $TMUX (format
			# "socket,pid,session"), which is empty when proj runs outside tmux
			# (the post-reboot case) - so provide it ourselves
			local socket
			socket=$(tmux display-message -p '#{socket_path}' 2>/dev/null) || true
			TMUX="${socket},proj,0" "$script" >/dev/null 2>&1 || true
		else
			# saves exist but the plugin is gone (e.g. deleted by a tpm
			# mishap) - stay loud, or the sessions are silently unrecoverable
			echo "Warning: tmux-resurrect saves exist but restore script is missing ($script); skipping restore" >&2
		fi
	fi

	# killing the throwaway lets a server with nothing restored exit cleanly
	tmux kill-session -t "__proj_restore__" 2>/dev/null || true
}

do_create() {
	local name="$1"
	[ -z "$name" ] && name=$(basename "$PWD")
	# tmux rewrites '.' and ':' to '_' itself, but keeps spaces, which would
	# need quoting at every call site; normalize all three for a predictable name
	name=$(printf '%s' "$name" | tr '.: ' '___')

	if session_exists "$name"; then
		die "Session '$name' already exists"
	fi

	if in_tmux; then
		# new-session -d may fail if tmux-resurrect created the session between our
		# check above and here; if so, just switch to the existing session
		if ! tmux new-session -d -s "$name" -c "$PWD" 2>/dev/null; then
			session_exists "$name" || die "Failed to create session '$name'"
		fi
		tmux switch-client -t "$name"
	else
		# -A attaches to an existing session rather than erroring if one appears
		# (e.g. created by tmux-resurrect when the server starts)
		tmux new-session -A -s "$name" -c "$PWD"
	fi
}

do_kill() {
	local name="$1"

	if [ -n "$name" ]; then
		session_exists "$name" || die "Session '$name' does not exist"
	elif in_tmux; then
		name=$(tmux display-message -p '#{session_name}')
	else
		if ! command -v fzf >/dev/null 2>&1; then
			die "Specify a session name or install fzf for interactive selection"
		fi
		local sessions
		sessions=$(list_sessions) || die "No tmux sessions running"
		[ -z "$sessions" ] && die "No tmux sessions running"
		name=$(echo "$sessions" | fzf --height=40% --reverse --prompt="Kill session: ") || exit 0
		[ -z "$name" ] && exit 0
	fi

	tmux kill-session -t "$name"
	echo "Killed session: $name"
}

find_matching_sessions() {
	local query="$1"
	local sessions
	sessions=$(sessions_by_recency)
	[ -z "$sessions" ] && return 0

	# Exact match first. -F throughout: a session name is a literal, so a query
	# containing '+' or '.' must not be read as a regex
	if echo "$sessions" | grep -qxF "$query"; then
		echo "$query"
		return 0
	fi

	# Substring match
	echo "$sessions" | grep -iF "$query" || true
}

do_attach() {
	local name="$1"

	# No name: fzf picker over all sessions
	if [ -z "$name" ]; then
		if ! command -v fzf >/dev/null 2>&1; then
			die "Specify a session name or install fzf for interactive selection"
		fi
		local sessions
		sessions=$(sessions_by_recency)
		[ -z "$sessions" ] && die "No tmux sessions running"
		local selected
		selected=$(echo "$sessions" | fzf --height=40% --reverse --prompt="Attach to session: ") || exit 0
		[ -z "$selected" ] && exit 0
		attach_session "$selected"
		return
	fi

	# Name given: find matches
	local matches
	matches=$(find_matching_sessions "$name")

	local count=0
	[ -n "$matches" ] && count=$(echo "$matches" | grep -c .)

	if [ "$count" -eq 1 ]; then
		attach_session "$matches"
	elif [ "$count" -gt 1 ]; then
		if ! command -v fzf >/dev/null 2>&1; then
			die "Multiple sessions match '$name': $(echo "$matches" | tr '\n' ' ')"
		fi
		local selected
		selected=$(echo "$matches" | fzf --height=40% --reverse --prompt="Multiple matches, select: ") || exit 0
		[ -z "$selected" ] && exit 0
		attach_session "$selected"
	else
		# Creating is always explicit (proj -c)
		local sessions
		sessions=$(list_sessions) || true
		if [ -n "$sessions" ]; then
			echo "Error: no session matching '$name'" >&2
			echo "Running: $(echo "$sessions" | tr '\n' ' ')" >&2
		else
			echo "Error: no tmux sessions running" >&2
		fi
		echo "Create one here with: proj -c $name" >&2
		exit 1
	fi
}

# One mode per run; a second mode flag would otherwise silently win or lose
set_mode() {
	if [ -n "$mode" ] && [ "$mode" != "$1" ]; then
		die "Options -c and -k are mutually exclusive"
	fi
	mode="$1"
}

main() {
	local mode=""
	local name=""

	while [ $# -gt 0 ]; do
		case "$1" in
			-h|--help)
				show_help
				exit 0
				;;
			-c|--create)
				set_mode create
				shift
				if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
					name="$1"
					shift
				fi
				;;
			-k|--kill)
				set_mode kill
				shift
				if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
					name="$1"
					shift
				fi
				;;
			-*)
				die "Unknown option: $1"
				;;
			*)
				# Overwriting an already-set name would silently run the last
				# one and drop the rest
				[ -n "$name" ] && die "Too many arguments: $1"
				name="$1"
				shift
				;;
		esac
	done

	if ! command -v tmux >/dev/null 2>&1; then
		die "tmux is not installed"
	fi

	maybe_restore

	case "$mode" in
		create) do_create "$name" ;;
		kill) do_kill "$name" ;;
		*) do_attach "$name" ;;
	esac
}

main "$@"
