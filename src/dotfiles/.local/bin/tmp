#!/bin/bash
# tmp - Quick temporary workspace creator
set -euo pipefail

USAGE="Usage: tmp [-l|-r|-d] [FILE...]
Create and cd to a timestamped temporary directory

Options:
  -l           List existing temp directories (with a contents preview) and
               select one, or create new if none selected
  -r           cd to most recent temp directory
  -d           Delete temp directories (interactive: enter numbers, 'a' for all, or Enter to cancel)
  -h, --help   Show this help message

-l, -r and -d select a mode and cannot be combined.

FILE arguments are opened in \$EDITOR inside the new workspace.

Examples:
  tmp               Create new temp dir and cd to it
  tmp test.py       Create temp dir, cd to it, and open test.py in \$EDITOR
  tmp a.md b.py     Same, with both files opened together
  tmp -l            List existing dirs and prompt for selection (default: create new)
  tmp -r            cd to most recent temp directory
  tmp -d            Delete temp directories interactively"

TMP_BASE="${TMPDIR:-/tmp}/tmp-workspaces"
RECENT=false
SELECT=false
DELETE=false

# getopts handles single-letter flags only, so catch the long help form up front
for arg in "$@"; do
  case "$arg" in
    --help) echo "$USAGE"; exit 0 ;;
  esac
done

# Parse options
while getopts "rldh" opt; do
  case $opt in
    r) RECENT=true ;;
    l) SELECT=true ;;
    d) DELETE=true ;;
    h) echo "$USAGE"; exit 0 ;;
    *) echo "$USAGE" >&2; exit 1 ;;
  esac
done

# Shift past options; remaining arguments are filenames to open
shift $((OPTIND - 1))

# -l/-r/-d are three separate modes. Refusing the combination beats silently
# honoring whichever one the branches below happen to test first.
MODES=0
[ "$RECENT" = true ] && MODES=$((MODES + 1))
[ "$SELECT" = true ] && MODES=$((MODES + 1))
[ "$DELETE" = true ] && MODES=$((MODES + 1))
if [ "$MODES" -gt 1 ]; then
  echo "tmp: -l, -r and -d cannot be combined" >&2
  echo "$USAGE" >&2
  exit 1
fi

# Short comma-separated preview of a workspace's contents, e.g.
# "test.py, data.csv, +3 more" or "(empty)"
contents_preview() {
  local dir="$1" limit=3 preview="" name i
  local names=()
  while IFS= read -r name; do
    [ -n "$name" ] && names+=("$name")
  done < <(ls -A "$dir" 2>/dev/null)

  if [ "${#names[@]}" -eq 0 ]; then
    echo "(empty)"
    return
  fi

  for i in "${!names[@]}"; do
    [ "$i" -ge "$limit" ] && break
    [ -n "$preview" ] && preview+=", "
    preview+="${names[$i]}"
  done
  if [ "${#names[@]}" -gt "$limit" ]; then
    preview+=", +$((${#names[@]} - limit)) more"
  fi
  echo "$preview"
}

# Numbered listing of workspaces (newest first) with contents previews;
# fills the global dirs array
list_workspaces() {
  local dir i
  dirs=()
  while IFS= read -r dir; do
    dirs+=("$dir")
  done < <(ls -t "$TMP_BASE")

  for i in "${!dirs[@]}"; do
    echo "$((i+1)). ${dirs[$i]}  $(contents_preview "$TMP_BASE/${dirs[$i]}")" >&2
  done
  echo >&2
}

# Delete temp directories interactively
if [ "$DELETE" = true ]; then
  if [ ! -d "$TMP_BASE" ] || [ -z "$(ls -A "$TMP_BASE" 2>/dev/null)" ]; then
    echo "No temporary workspaces to delete" >&2
    exit 0
  fi

  echo "Temp workspaces:" >&2
  list_workspaces

  # Prompt for deletion (read -p writes to stderr, keeping stdout eval-clean)
  if ! read -rp "Enter numbers to delete (space-separated), 'a' for all, or Enter to cancel: " choice; then
    # EOF rather than an answer: abort instead of acting on a blank reply
    echo >&2
    echo "Aborted." >&2
    exit 0
  fi

  # If empty, cancel
  if [ -z "$choice" ]; then
    echo "Cancelled" >&2
    exit 0
  fi

  # Handle "all"
  if [[ "$choice" =~ ^(a|all)$ ]]; then
    echo "Deleting all workspaces..." >&2
    rm -rf "${TMP_BASE:?}"/*
    echo "All workspaces deleted" >&2
    exit 0
  fi

  # Handle space-separated numbers
  deleted_count=0
  for num in $choice; do
    if [[ "$num" =~ ^[0-9]+$ ]] && [ "$num" -ge 1 ] && [ "$num" -le "${#dirs[@]}" ]; then
      dir_to_delete="${dirs[$((num-1))]}"
      rm -rf "${TMP_BASE:?}/$dir_to_delete"
      echo "Deleted: $dir_to_delete" >&2
      # Arithmetic assignment, not ((deleted_count++)): the latter returns 1
      # when the pre-increment value is 0, which is a trap under set -e
      deleted_count=$((deleted_count + 1))
    else
      echo "Invalid number: $num (skipping)" >&2
    fi
  done

  if [ $deleted_count -gt 0 ]; then
    echo "Deleted $deleted_count workspace(s)" >&2
  else
    echo "No workspaces deleted" >&2
  fi
  exit 0
fi

# cd to most recent temp directory
if [ "$RECENT" = true ]; then
  if [ -d "$TMP_BASE" ]; then
    # Read the first line rather than `ls | head`: under pipefail, head exiting
    # early can SIGPIPE ls and fail the whole pipeline once the listing grows
    # past the pipe buffer.
    LATEST_DIR=""
    # shellcheck disable=SC2012  # workspace names are self-generated timestamps
    while IFS= read -r name; do
      LATEST_DIR="$name"
      break
    done < <(ls -t "$TMP_BASE")
    if [ -n "$LATEST_DIR" ]; then
      echo "cd \"$TMP_BASE/$LATEST_DIR\""
    else
      echo "No temporary workspaces found" >&2
      exit 1
    fi
  else
    echo "No temporary workspaces found" >&2
    exit 1
  fi
  exit 0
fi

# Select from existing temp directories
if [ "$SELECT" = true ]; then
  if [ -d "$TMP_BASE" ] && [ -n "$(ls -A "$TMP_BASE" 2>/dev/null)" ]; then
    echo "Existing temp workspaces:" >&2
    list_workspaces

    # Prompt for selection (read -p writes to stderr, keeping stdout eval-clean)
    if ! read -rp "Select number (or press Enter to create new): " choice; then
      # EOF rather than an answer: abort instead of falling through to create
      echo >&2
      echo "Aborted." >&2
      exit 0
    fi

    # If empty, fall through to create new
    if [ -z "$choice" ]; then
      # Fall through to create new workspace below
      true
    elif [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#dirs[@]}" ]; then
      # Valid selection
      selected_dir="${dirs[$((choice-1))]}"
      echo "cd \"$TMP_BASE/$selected_dir\""
      exit 0
    else
      echo "Invalid selection" >&2
      exit 1
    fi
  fi
  # If no existing dirs or user pressed Enter, fall through to create new
fi

# Create temp workspace
mkdir -p "$TMP_BASE"
TIMESTAMP=$(date +"%Y%m%d-%H%M%S")
TMP_DIR="$TMP_BASE/$TIMESTAMP"

# Plain mkdir (no -p) is atomic and fails when the name is taken, so two runs
# in the same second get separate workspaces instead of silently sharing one.
SUFFIX=2
while ! mkdir "$TMP_DIR" 2>/dev/null; do
  if [ ! -d "$TMP_DIR" ]; then
    echo "Failed to create workspace: $TMP_DIR" >&2
    exit 1
  fi
  TMP_DIR="$TMP_BASE/$TIMESTAMP-$SUFFIX"
  SUFFIX=$((SUFFIX + 1))
done

echo "Created temporary workspace: $TMP_DIR"

# Output the cd command for the parent shell to eval
echo "cd \"$TMP_DIR\""

# Emit one EDITOR_CMD line per filename for the wrapper to open in $EDITOR
for filename in "$@"; do
  case "$filename" in
    */*) mkdir -p "$TMP_DIR/$(dirname "$filename")" ;;
  esac
  echo "EDITOR_CMD:$filename"
done
