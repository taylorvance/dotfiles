#!/usr/bin/env bash
set -euo pipefail

# git-prune-worktrees - Remove worktrees whose removal loses none of your work
#
# Usage: git prune-worktrees [-n]
#
# A linked worktree, detached or on a branch, is removable when it has no
# uncommitted changes and none of your commits in it are missing from every
# remote. Removal deletes the worktree and its branch. See -h for details.

show_help() {
    cat <<'EOF'
Usage: git prune-worktrees [-n]

Remove linked worktrees, and their branches, when removing them loses none
of your work. Detached worktrees are included.

A worktree is removable when both hold:
  - No uncommitted changes (untracked files count)
  - Every commit of yours in it is on a remote. Yours means committed as
    this repo's user.email (every commit, if it is unset); other people's
    commits don't count, since they still have them.

Anything else is kept, with the reason:
  [uncommitted changes]
  [N of your commits on no remote]
  [locked]
  [current worktree]
  [git status failed] / [git log failed]

Worktrees whose directory is already gone are forgotten first
(git worktree prune).

Options:
  -n, --dry-run   List worktrees without changing anything
  -h, --help      Show this help message

Prompt options:
  y   Remove all removable worktrees
  N   Abort (default)
  i   Interactive selection via fzf

Removal runs 'git worktree remove --force', which also deletes gitignored
files such as node_modules or a copied .env, then 'git branch -D'. A branch
whose remote copy was deleted after a squash merge shows as kept; remove it
by hand.
EOF
    exit 0
}

DRY_RUN=false

while [[ $# -gt 0 ]]; do
    case $1 in
        -n|--dry-run) DRY_RUN=true; shift ;;
        -h|--help) show_help ;;
        -*) echo "Error: Unknown option: $1" >&2; exit 1 ;;
        *) echo "Error: Unexpected argument: $1" >&2; exit 1 ;;
    esac
done

if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    echo "Error: Not a git repository" >&2
    exit 1
fi

MY_EMAIL=$(git config user.email || true)
CURRENT=$(cd "$(git rev-parse --show-toplevel)" && pwd -P)

# Count the commits of yours in a worktree that no remote has
my_unpushed_count() {
    local emails
    emails=$(git -C "$1" log --format=%ce HEAD --not --remotes) || return 1
    if [[ -z "$MY_EMAIL" ]]; then
        grep -c . <<< "$emails" || true
    else
        grep -cixF -- "$MY_EMAIL" <<< "$emails" || true
    fi
}

# Print why a worktree must be kept; print nothing when removal loses no work
keep_reason() {
    local path="$1" locked="$2" status count
    if [[ "$locked" == true ]]; then
        echo "locked"
    elif [[ "$(cd "$path" && pwd -P)" == "$CURRENT" ]]; then
        echo "current worktree"
    elif ! status=$(git -C "$path" status --porcelain --untracked-files=normal 2>/dev/null); then
        echo "git status failed"
    elif [[ -n "$status" ]]; then
        echo "uncommitted changes"
    elif ! count=$(my_unpushed_count "$path" 2>/dev/null); then
        echo "git log failed"
    elif [[ "$count" -gt 0 ]]; then
        echo "$count of your commits on no remote"
    fi
}

# Parallel arrays, one entry per linked worktree
PATHS=()
BRANCHES=()
LABELS=()
REASONS=()
ghosts=0

add_worktree() {
    local path="$1" branch="$2" head="$3" locked="$4" label="$2"
    [[ -z "$branch" ]] && label="${head:0:7} (detached)"
    PATHS+=("$path")
    BRANCHES+=("$branch")
    LABELS+=("$label")
    REASONS+=("$(keep_reason "$path" "$locked")")
}

first=true
path="" branch="" head="" locked=false prunable=false
while IFS= read -r line; do
    case "$line" in
        "worktree "*) path=${line#worktree } ;;
        "HEAD "*) head=${line#HEAD } ;;
        "branch refs/heads/"*) branch=${line#branch refs/heads/} ;;
        locked|"locked "*) locked=true ;;
        prunable|"prunable "*) prunable=true ;;
        "")
            if [[ -n "$path" ]]; then
                if [[ "$first" == true ]]; then
                    first=false  # the main worktree always comes first
                elif [[ "$locked" != true && ( "$prunable" == true || ! -d "$path" ) ]]; then
                    ghosts=$((ghosts + 1))
                else
                    add_worktree "$path" "$branch" "$head" "$locked"
                fi
            fi
            path="" branch="" head="" locked=false prunable=false
            ;;
    esac
done < <(git worktree list --porcelain; echo "")

if [[ $ghosts -gt 0 ]]; then
    if [[ "$DRY_RUN" == true ]]; then
        echo "$ghosts worktree(s) with a missing directory; a real run forgets them."
    else
        git worktree prune
        echo "Forgot $ghosts worktree(s) whose directory was gone."
    fi
fi

if [[ ${#PATHS[@]} -eq 0 ]]; then
    echo "No worktrees to prune."
    exit 0
fi

removable=0
for i in "${!PATHS[@]}"; do
    [[ -z "${REASONS[$i]}" ]] && removable=$((removable + 1))
done
kept=$(( ${#PATHS[@]} - removable ))

# List the removable (want=removable) or kept (want=kept) worktrees
list_worktrees() {
    local want="$1" i
    for i in "${!PATHS[@]}"; do
        if [[ "$want" == removable && -z "${REASONS[$i]}" ]]; then
            printf '  %-30s  %s\n' "${LABELS[$i]}" "${PATHS[$i]}"
        elif [[ "$want" == kept && -n "${REASONS[$i]}" ]]; then
            printf '  %-30s  %s  [%s]\n' "${LABELS[$i]}" "${PATHS[$i]}" "${REASONS[$i]}"
        fi
    done
}

echo ""
if [[ $removable -gt 0 ]]; then
    echo "Removable:"
    list_worktrees removable
    echo ""
fi
if [[ $kept -gt 0 ]]; then
    echo "Kept:"
    list_worktrees kept
    echo ""
fi
echo "$removable removable, $kept kept."
echo ""

if [[ $removable -eq 0 || "$DRY_RUN" == true ]]; then
    exit 0
fi

remove_worktree() {
    local i="$1" err
    if ! err=$(git worktree remove --force "${PATHS[$i]}" 2>&1); then
        echo "Failed to remove ${PATHS[$i]}: $err" >&2
        return 0
    fi
    if [[ -n "${BRANCHES[$i]}" ]] && ! err=$(git branch -D "${BRANCHES[$i]}" 2>&1); then
        echo "Removed ${PATHS[$i]}, but failed to delete branch ${BRANCHES[$i]}: $err" >&2
        return 0
    fi
    echo "Removed ${LABELS[$i]} (${PATHS[$i]})"
}

while true; do
    if ! read -rp "Remove all removable worktrees? [y/N/i] " choice; then
        echo ""
        echo "Aborted."
        exit 0
    fi
    choice=$(echo "$choice" | tr '[:upper:]' '[:lower:]')
    case "$choice" in
        y|yes)
            for i in "${!PATHS[@]}"; do
                [[ -z "${REASONS[$i]}" ]] && remove_worktree "$i"
            done
            exit 0
            ;;
        n|no|"")
            echo "Aborted."
            exit 0
            ;;
        i|interactive)
            if ! command -v fzf &>/dev/null; then
                echo "Error: fzf required for interactive mode" >&2
                continue
            fi

            # Lines are "index<TAB>label  path"; fzf hides the index
            FZF_INPUT=""
            for i in "${!PATHS[@]}"; do
                [[ -n "${REASONS[$i]}" ]] && continue
                FZF_INPUT+="$i"$'\t'"$(printf '%-30s  %s' "${LABELS[$i]}" "${PATHS[$i]}")"$'\n'
            done

            SELECTED=$(printf '%s' "$FZF_INPUT" | \
                fzf --multi \
                    --delimiter=$'\t' \
                    --with-nth=2.. \
                    --header="TAB to select, ENTER to confirm" \
                    --reverse) || {
                echo "Aborted."
                exit 0
            }

            [[ -z "$SELECTED" ]] && { echo "Nothing selected."; exit 0; }

            while IFS= read -r line; do
                idx=${line%%$'\t'*}
                [[ "$idx" =~ ^[0-9]+$ && $idx -lt ${#PATHS[@]} && -z "${REASONS[$idx]}" ]] || continue
                remove_worktree "$idx"
            done <<< "$SELECTED"
            exit 0
            ;;
        *)
            echo "Please enter y, n, or i"
            ;;
    esac
done
