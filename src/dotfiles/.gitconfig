[user]
	name = Taylor Vance
	# Email intentionally unset here (work/personal split via per-repo config
	# or ~/.gitconfig.local); refuse to guess an identity instead
	useConfigOnly = true

[alias]
	# inspect
	st = status
	# branch summary vs origin/<default>; fetches last, so only the final "behind" line waits on it
	stm = "!b=$(git default) && m=$(git merge-base \"origin/$b\" HEAD) \
		&& s=$(git diff --shortstat \"$m\") \
		&& echo \"$(git rev-list --count \"origin/$b..HEAD\") ahead of origin/$b:${s:- no changes}\" \
		&& git --no-pager l HEAD --not \"$m^@\" \
		&& u=$(git rev-parse --abbrev-ref @{u} 2>/dev/null || :) \
		&& git status -s$([ \"$u\" = \"origin/$b\" ] || echo b) \
		&& f= && { git fetch -q origin \"$b\" || f=' (fetch failed; as of last fetch)'; } \
		&& k=$(git rev-list --count \"HEAD..origin/$b\") \
		&& if [ \"$k\" -eq 0 ]; then echo \"up to date with origin/$b$f\"; \
		else r= && z= && if [ -t 1 ]; then r='\\033[31m' z='\\033[0m'; fi \
			&& printf \"$r%s behind origin/%s$z%s\\n\" \"$k\" \"$b\" \"$f\"; fi \
		&& [ -z \"$f\" ]"
	di = diff
	dip = diff HEAD~1
	dis = diff --staged
	dio = diff @{u}  # vs upstream: unpushed + uncommitted changes
	# vs merge-base with origin/<default>: only this branch's changes (PR-style)
	dim = "!b=$(git default) && git diff \"$(git merge-base \"origin/$b\" HEAD)\""
	# vs HEAD's pre-amend self; git errors if HEAD wasn't created by an amend
	dia = "!n=$(git log -g --format='%H %gs' HEAD | grep -n -m1 \"^$(git rev-parse HEAD) commit (amend): \" | cut -d: -f1); git diff \"HEAD@{$n}\" HEAD"
	# vs upstream, per commit: did the patches change, or only the base? (post-rebase check)
	dir = "!b=$(git default) && git range-diff \"origin/$b\" @{u} @"
	l = log --graph --abbrev-commit --pretty='%C(auto)%h%d %s %Cgreen(%cr)%Creset %C(bold blue)<%an>%Creset'
	g = grep --break --heading --line-number
	cfg = config --list

	# stage / commit
	a = add .
	c = commit
	cm = commit -m
	amend = commit --amend --no-edit

	# branch / sync
	s = switch
	f = fetch
	p = pull
	pfwl = push --force-with-lease --force-if-includes  # safe force-push (won't clobber unseen commits)
	# the remote's default branch (main/master/...)
	default = "!ref=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) || { echo 'origin/HEAD not set; run: git remote set-head origin -a' >&2; exit 1; }; echo \"${ref#origin/}\""
	pm = "!b=$(git default) && git fetch origin \"$b:$b\""                # pull default without switching
	smp = "!b=$(git default) && git switch \"$b\" && git pull --ff-only"  # switch to default branch, ff-only pull
	fmom = "!b=$(git default) && git fetch && git merge \"origin/$b\""    # fetch, merge origin/<default>
	from = "!b=$(git default) && git fetch && git rebase \"origin/$b\""   # fetch, rebase onto origin/<default>

[branch]
	sort = -committerdate

[commit]
	verbose = true

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[pull]
	ff = only

[rebase]
	autostash = true
	autosquash = true

[rerere]
	# remember conflict resolutions and replay them when the same conflict reappears
	enabled = true

[diff]
	tool = nvimdiff
	colorMoved = default
	algorithm = histogram
[merge]
	tool = nvimdiff
	# include the common-ancestor version in conflict markers
	conflictStyle = zdiff3
[mergetool]
	keepBackup = false

[pager]
	diff = delta
	log = delta
	reflog = delta
	show = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	line-numbers = true
	syntax-theme = tokyonight_moon
	file-decoration-style = magenta box
	hunk-header-decoration-style = cyan box

[core]
	editor = nvim
	excludesFile = ~/.config/git/ignore
	pager = delta

[grep]
	extendRegexp = true
	lineNumber = true

[credential]
	helper = osxkeychain

[include]
	path = ~/.gitconfig.local
